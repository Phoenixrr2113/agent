{
  "name": "@agent/server",
  "version": "0.1.0",
  "description": "HTTP server for agent platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent/core": "workspace:*",
    "@agent/device-use": "workspace:*",
    "@agent/shared": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.4.6",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.16"
  }
}
