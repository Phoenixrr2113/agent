{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "exactOptionalPropertyTypes": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@agent/memory": ["../memory/dist"],
      "@agent/memory/*": ["../memory/dist/*"],
      "@agent/shared": ["../shared/dist"],
      "@agent/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/tests/**/*"]
}
