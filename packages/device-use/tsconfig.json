{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@agent/shared": ["../shared/dist"],
      "@agent/shared/*": ["../shared/dist/*"]
    },
    "lib": ["dom", "esnext"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
