{
  "name": "@agent/device-use",
  "version": "0.1.0",
  "description": "Cross-platform device control for desktop and mobile (macOS, Linux, Windows, iOS, Android)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drivers/desktop.js": {
      "import": "./dist/drivers/desktop.js",
      "types": "./dist/drivers/desktop.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agent/shared": "workspace:*",
    "@ai-sdk/anthropic": "^1.0.7",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "ai": "6.0.0-beta.120",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@agent/mobile-accessibility": "workspace:*",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
