{
  "name": "ai-agent-runtime",
  "version": "0.1.0",
  "description": "Server-side AI agent runtime with persistent memory, web search, shell execution, and optional codebase understanding",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "runtime",
    "ai-agent",
    "openrouter",
    "vercel-ai-sdk",
    "memory",
    "rag",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "bin": {
    "ai-agent-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "build": "tsc",
    "chat": "tsx src/chat.ts",
    "server": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/cohere": "3.0.0-beta.38",
    "@ai-sdk/google": "3.0.0-beta.59",
    "@hono/node-server": "^1.19.6",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^1.0.0",
    "ai": "6.0.0-beta.120",
    "better-sqlite3": "^12.4.6",
    "code-chopper": "^0.1.6",
    "dotenv": "^17.2.3",
    "hono": "^4.10.7",
    "jsdom": "^27.2.0",
    "wink-bm25-text-search": "^3.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
