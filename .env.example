# ============================================
# REQUIRED API KEYS
# ============================================

# OpenRouter API Key (REQUIRED)
# Used for: LLM completions via multiple providers
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Google Generative AI (Gemini) API Key (REQUIRED)
# Used for: embeddings, context generation, chat completions
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# ============================================
# OPTIONAL - WEB SEARCH
# ============================================

# Brave Search API Key (OPTIONAL)
# Used for: web search capabilities
# Get your API key from: https://brave.com/search/api/
BRAVE_API_KEY=BSA...

# Tavily API Key (OPTIONAL)
# Used for: research-focused web search
# Get your API key from: https://tavily.com/
TAVILY_API_KEY=tvly-...

# ============================================
# OPTIONAL - ENHANCED FEATURES
# ============================================

# Cohere API Key (OPTIONAL)
# Used for: reranking in RAG retrieval
# Get your API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# ============================================
# OPTIONAL - CONFIGURATION
# ============================================

# Memory Database Path (OPTIONAL)
# Default: ./memory.db
# Specify custom location for SQLite memory database
# MEMORY_DB_PATH=./memory.db

# Model Selection (OPTIONAL)
# Override default models for different tasks
# MODEL_STANDARD=google/gemini-2.0-flash-001
# MODEL_EXTRACTION=google/gemini-2.0-flash-001

# Log Level (OPTIONAL)
# Options: debug, info, warn, error
# Default: info
# LOG_LEVEL=info

# Log File (OPTIONAL)
# Enable file logging (in addition to console)
# LOG_FILE=logs/agent.log

# Server Port (OPTIONAL)
# Default: 3000
# PORT=3000

# Workspace Root (OPTIONAL)
# Enable codebase tools (RAG semantic search, grep, validate)
# WORKSPACE_ROOT=/path/to/your/project

# ============================================
# OPTIONAL - OLLAMA (LOCAL MODELS)
# ============================================

# Ollama API Base URL (OPTIONAL)
# Use local models via Ollama
# Default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# OPTIONAL - GRAPHITI (ADVANCED MEMORY)
# ============================================

# Graphiti API URL (OPTIONAL)
# Use Neo4j-backed graph memory instead of SQLite
# Requires Docker: docker compose -f docker/graphiti-compose.yml up -d
# GRAPHITI_URL=http://localhost:8000
