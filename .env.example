# OpenRouter API Key (get free key at https://openrouter.ai/)
OPENROUTER_API_KEY=sk-or-v1-...

# Google Generative AI API Key (get free key at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# Model to use (recommended free options for coding)
MODEL=qwen/qwen3-coder:free

# Other free model options:
# MODEL=deepseek/deepseek-chat-v3-0324:free
# MODEL=tngtech/deepseek-r1t2-chimera:free
# MODEL=x-ai/grok-4.1-fast

# Web Search APIs (optional)
BRAVE_API_KEY=BSA...
TAVILY_API_KEY=tvly-...

# Memory - Uses MemoryLite (SQLite) by default
MEMORY_DB_PATH=./memory.db

# Optional: Graphiti (Neo4j-backed) - Only if you need production-grade memory
# Run: docker compose -f docker/graphiti-compose.yml up -d
# GRAPHITI_URL=http://localhost:8000
# OPENAI_API_KEY=sk-...
